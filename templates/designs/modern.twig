<!DOCTYPE html>
<html lang="{{ locale() }}">
<head>
    {% include '@card/_meta.twig' %}
</head>
<body class="card-page design-modern" data-design="modern">
<header class="card-hero">
    {% if avatar_url %}
        <img class="card-avatar" src="{{ avatar_url }}" alt="">
    {% else %}
        <span class="card-avatar card-avatar-empty">{{ provider.name|first|upper }}</span>
    {% endif %}
    <h1>{{ provider.name }}</h1>
    {% if headline %}<p class="card-headline">{{ headline }}</p>{% endif %}
    {% if card.company %}<p class="card-company">{{ card.company }}</p>{% endif %}
    {% if category_name %}<span class="card-category">{{ category_name }}</span>{% endif %}
</header>

<main class="card-sheet">
    {% include '@card/_contact_links.twig' with {list_class: 'card-contact-pills'} %}

    {% if description %}<p class="card-bio">{{ description|nl2br }}</p>{% endif %}

    {% include '@card/_actions.twig' %}
    {% include '@card/_gallery.twig' %}
    {% include '@card/_offerings.twig' %}
    {% include '@card/_opening_hours.twig' %}
    {% include '@card/_footer.twig' %}
</main>
</body>
</html>
