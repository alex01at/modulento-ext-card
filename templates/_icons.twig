{# Small line icons, drawn inline so nothing is loaded from elsewhere. #}
{% macro icon(name, class = 'icon') %}
<svg class="{{ class }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {% if name == 'phone' %}
        <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.7 21 3 13.3 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.2 2.2Z"/>
    {% elseif name == 'whatsapp' %}
        <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2Z"/>
        <path d="M8.5 8.3c.2-.4.4-.4.6-.4h.5c.2 0 .4 0 .5.4.2.5.6 1.6.7 1.7.1.1.1.3 0 .5-.1.2-.2.3-.3.5-.2.2-.3.3-.1.5.2.3 1 1.5 2.1 2.1.3.2.5.1.6-.1.2-.2.5-.5.6-.7.1-.2.3-.2.5-.1.7.3 1.5.7 1.7.8.2.1.3.2.3.3 0 .4-.1 1-.5 1.4-.4.4-1.1.7-1.9.5-1.9-.4-3.9-1.7-5.3-3.1-1.1-1.1-1.9-2.4-2.3-3.7-.2-.6 0-1.2.4-1.6Z" fill="currentColor" stroke="none"/>
    {% elseif name == 'email' %}
        <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>
    {% elseif name == 'website' %}
        <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"/>
    {% elseif name == 'address' %}
        <path d="M12 21s7-7.1 7-12a7 7 0 1 0-14 0c0 4.9 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/>
    {% elseif name == 'linkedin' %}
        <rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7.5 10v6.5M7.5 7.3v.1M12 16.5V13c0-1.4.9-2.2 2-2.2s1.9.8 1.9 2.2v3.5" fill="none"/>
    {% elseif name == 'instagram' %}
        <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>
    {% elseif name == 'facebook' %}
        <path d="M14 21v-7h2.3l.4-3H14V9c0-.9.2-1.5 1.5-1.5H17V5c-.3 0-1.2-.1-2.2-.1-2.2 0-3.8 1.3-3.8 3.8V11H8.5v3H11v7Z"/>
    {% elseif name == 'youtube' %}
        <rect x="2.5" y="5.5" width="19" height="13" rx="3"/><path d="m10 9 5 3-5 3Z" fill="currentColor" stroke="none"/>
    {% elseif name == 'snapchat' %}
        <path d="M12 3c2.5 0 4 1.8 4 4.3 0 1 0 2.2.2 3 .4.2 1 .1 1.4-.1.4-.2.9 0 .9.5 0 .6-.8 1-1.4 1.3.1.5.6.8 1.4 1-.1.6-.9 1-1.6 1.1-.1.4-.2.8-.6 1-.4.2-1 .1-1.5.3-.5.2-.8.9-2.8.9s-2.3-.7-2.8-.9c-.5-.2-1.1-.1-1.5-.3-.4-.2-.5-.6-.6-1-.7-.1-1.5-.5-1.6-1.1.8-.2 1.3-.5 1.4-1-.6-.3-1.4-.7-1.4-1.3 0-.5.5-.7.9-.5.4.2 1 .3 1.4.1.2-.8.2-2 .2-3C8 4.8 9.5 3 12 3Z"/>
    {% elseif name == 'booking' %}
        <rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 3v3M16 3v3"/><circle cx="12" cy="14" r="2"/>
    {% elseif name == 'vcard' %}
        <path d="M12 3 4 7v10l8 4 8-4V7Z"/><path d="M12 3v18"/>
    {% elseif name == 'heart' %}
        <path d="M12 20.5s-7.5-4.6-9.8-9.1C.7 8 2.5 4.5 6 4a5 5 0 0 1 6 2.6A5 5 0 0 1 18 4c3.5.5 5.3 4 3.8 7.4-2.3 4.5-9.8 9.1-9.8 9.1Z" fill="currentColor" stroke="none"/>
    {% elseif name == 'arrow' %}
        <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
    {% elseif name == 'image' %}
        <rect x="3" y="4" width="18" height="16" rx="2.5"/><circle cx="9" cy="10" r="1.6"/><path d="m4 18 5.5-5 4 3.5 2.5-2.2L20 18"/>
    {% endif %}
</svg>
{% endmacro %}
