{% extends 'layout/base.twig' %}

{% block title %}{{ trans('card.team.title') }} – {{ site_name }}{% endblock %}

{% block content %}
<h1>{{ trans('card.team.title') }}</h1>
<p>{{ trans('card.team.found_intro') }}</p>

<form method="post" action="{{ url('/account/team') }}" class="stack-form">
    {{ csrf_field() }}
    <label for="company">{{ trans('card.team.company') }}</label>
    <input id="company" name="company" maxlength="150" required>
    <button type="submit">{{ trans('card.team.found_submit') }}</button>
</form>
{% endblock %}
